# Runtime only: copy to ignored .env.local and supply restricted-role credentials.
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=postgresql://careathome_app:REPLACE@YOUR-NEON-HOST/careathome?sslmode=verify-full&channel_binding=require
AUTH_DATABASE_URL=postgresql://careathome_auth:REPLACE@YOUR-NEON-HOST/careathome?sslmode=verify-full&channel_binding=require
BETTER_AUTH_SECRET=REPLACE_WITH_48_RANDOM_BYTES_ENCODED_AS_HEX
AWS_ENDPOINT_URL_S3=https://YOUR-BRANCH-STORAGE-ENDPOINT
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=REPLACE_WITH_STORAGE_TOKEN_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_STORAGE_S3_SECRET
CARE_SUMMARY_ADAPTER=local-template-v1
PLAYWRIGHT_CHANNEL=chrome
# Migration and worker connections belong in ignored .env.neon, not app runtime.
