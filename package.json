{
  "name": "careathome-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "test:integration": "node --env-file=.env.local tests/integration/foundation.mjs",
    "local:env": "node scripts/local-env.mjs",
    "local:seed-accounts": "node --env-file=.env.local scripts/provision-local.mjs",
    "test:workflows": "node --env-file=.env.local tests/integration/care-workflows.mjs",
    "local:seed-care": "node --env-file=.env.local scripts/seed-care-demo.mjs",
    "local:notifications": "node --env-file=.env.local scripts/notifications.mjs",
    "review:visual": "node scripts/visual-review.mjs",
    "local:backup": "node --env-file=.env.local scripts/backup-local.mjs",
    "local:recovery-drill": "node --env-file=.env.local scripts/backup-local.mjs --verify-restore"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@radix-ui/react-slot": "1.5.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.57.0",
    "next": "16.4.0",
    "nodemailer": "10.1.1",
    "pg": "8.23.1",
    "playwright": "1.64.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "prettier": "3.9.10",
    "supabase": "2.120.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  },
  "type": "module",
  "packageManager": "npm@10.9.8"
}
