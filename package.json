{
  "name": "careathome-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:integration": "node --experimental-strip-types --env-file=.env.neon tests/integration/neon-foundation.mjs",
    "local:seed-accounts": "node --conditions=react-server --experimental-strip-types --env-file=.env.neon scripts/neon-demo-accounts.mjs",
    "test:workflows": "node --conditions=react-server --experimental-strip-types --env-file=.env.neon tests/integration/neon-care-workflows.mjs",
    "local:seed-care": "node --conditions=react-server --experimental-strip-types --env-file=.env.neon scripts/neon-seed-care.mjs",
    "local:notifications": "node --env-file=.env.neon scripts/neon-notifications.mjs",
    "review:visual": "node scripts/visual-review.mjs",
    "db:plan": "node --env-file=.env.neon scripts/neon-migrate.mjs",
    "db:migrate": "node --env-file=.env.neon scripts/neon-migrate.mjs --apply",
    "test:storage": "node --conditions=react-server --experimental-strip-types --env-file=.env.neon tests/integration/neon-storage.mjs",
    "test:auth": "node --env-file=.env.neon tests/integration/neon-auth-http.mjs",
    "test:recovery": "playwright test tests/e2e/email-otp.spec.ts --grep \"protects recovery\"",
    "local:inbox": "node --env-file=.env.neon scripts/neon-inbox.mjs",
    "test:account-security": "node --conditions=react-server --experimental-strip-types --env-file=.env.neon tests/integration/neon-account-security.mjs",
    "test:otp": "node --conditions=react-server --experimental-strip-types --env-file=.env.neon tests/integration/neon-email-otp.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@neondatabase/serverless": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@sparticuz/chromium": "153.0.0",
    "better-auth": "1.7.9",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.57.0",
    "next": "16.4.0",
    "nodemailer": "10.1.2",
    "pg": "8.23.1",
    "playwright": "1.64.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  },
  "type": "module",
  "packageManager": "npm@10.9.8"
}
